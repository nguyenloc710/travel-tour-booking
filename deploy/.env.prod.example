# Mẫu cấu hình cho máy chủ. Chép thành `.env` NGAY CẠNH các file compose trên
# VPS, điền giá trị thật, rồi `chmod 600 .env`.
#
# File `.env` thật KHÔNG BAO GIỜ vào git và không bao giờ vào ảnh Docker —
# docs/34 mục 7. `.dockerignore` đã chặn sẵn `**/.env*`.
#
# Mẫu này viết sẵn cho chế độ **CHƯA CÓ TÊN MIỀN**: chạy bằng IP, không HTTPS.
# Mỗi khối có ghi phải đổi gì khi lên tên miền.

# ------------------------------------------------------- chọn hình dạng chạy
#
# Compose tự đọc biến này từ `.env`, nên không cần `-f` ở dòng lệnh. Đúng một
# dòng quyết định máy chủ chạy theo hình dạng nào.
#
#   compose.prod.yaml:compose.ip.yaml       ← chưa có tên miền (đang dùng)
#   compose.prod.yaml:compose.tenmien.yaml  ← đã có tên miền, có HTTPS
# Dấu phân cách là `:` vì máy chủ chạy Linux. (Trên Windows compose đòi `;` —
# chỉ liên quan nếu bạn thử bộ file này trên máy mình.)
COMPOSE_FILE=compose.prod.yaml:compose.ip.yaml

# --------------------------------------------------------- địa chỉ công khai
#
# Đây là địa chỉ như TRÌNH DUYỆT KHÁCH nhìn thấy, không phải địa chỉ nội bộ.
# Thay 203.0.113.5 bằng IP thật của VPS.
#
# Ba giá trị này phải KHỚP với ba biến tương ứng trên GitHub Variables
# (PUBLIC_SITE_URL, MEDIA_*) — chúng bị nướng vào ảnh lúc build, docs/34 mục
# 5.3. Lệch nhau thì trình duyệt báo lỗi CORS và log máy chủ không nói gì.
SITE_URL=http://203.0.113.5:4000
MEDIA_PUBLIC_URL=http://203.0.113.5:4003/travel-media

# Cổng mở ra ngoài.
#
# Dải 4000–4004 chọn vì máy chủ đã có chủ ở 8080 (clothing-store-api), 9000 và
# 9001 (comic-minio), 8091 (comic-caddy), 5173, 5179, 3309, 16379 và 5432.
# Kiểm lại trước khi chạy lần đầu:
#
#     ss -tlnp | grep -E ':(4000|4001|4002|4003|4004)s'
#
# Không ra dòng nào là còn trống. Đổi cổng thì nhớ đổi CẢ BA chỗ: dòng ở đây,
# SITE_URL/MEDIA_PUBLIC_URL ở trên, và Variables trên GitHub.
SITE_PORT=4000
ADMIN_PORT=4001
API_PORT=4002
MINIO_PORT=4003
# Bảng điều khiển MinIO — chỉ nghe trên 127.0.0.1, xem qua SSH tunnel.
MINIO_CONSOLE_PORT=4004

# ------------------------------------------------------------------ bảo mật
#
# CHƯA CÓ HTTPS thì cả hai phải để đúng như dưới đây.
#
# Đặt COOKIE_SECURE=true khi đang chạy http là trình duyệt lặng lẽ vứt cookie
# phiên: đăng nhập trang quản trị trả về 204 thành công, rồi màn hình kế tiếp
# vẫn đá ngược về trang đăng nhập, và không có lỗi nào ở bất cứ đâu.
#
# Lên tên miền thì đổi thành: COOKIE_SECURE=true, FORWARD_HEADERS=framework
COOKIE_SECURE=false
FORWARD_HEADERS=none

# ------------------------------------------------------------------ registry
#
# Chữ thường toàn bộ — Docker không chấp nhận chữ hoa trong tên ảnh, mà tên chủ
# repo GitHub thì có thể có.
REGISTRY=ghcr.io/nguyenloc710

# Thẻ ảnh = commit SHA. Pipeline tự ghi đè giá trị này mỗi lần triển khai; dòng
# ở đây chỉ để `docker compose` chạy tay không báo thiếu biến.
TAG=

# ---------------------------------------------------------------------- CSDL
DB_NAME=travel
DB_USER=travel
# BÍ MẬT. Không phải `travel` — điều kiện chặn của docs/34 mục 5.2.
# Sinh bằng:  openssl rand -base64 32 | tr -d '$/+='
DB_PASSWORD=

# ------------------------------------------------------------------ kho ảnh
MINIO_BUCKET=travel-media
MINIO_ROOT_USER=travel
# BÍ MẬT. Sinh bằng:  openssl rand -base64 32 | tr -d '$/+='
MINIO_ROOT_PASSWORD=

# ------------------------------------------------------ CHỈ DÙNG KHI CÓ TÊN MIỀN
#
# Năm dòng dưới đây bị bỏ qua ở chế độ IP. Điền chúng khi đổi COMPOSE_FILE sang
# compose.tenmien.yaml; lúc đó chúng thành bắt buộc và compose sẽ dừng nếu thiếu.
#SITE_DOMAIN=vidu.com
#ADMIN_DOMAIN=quantri.vidu.com
#API_DOMAIN=api.vidu.com
#MEDIA_DOMAIN=anh.vidu.com
#ACME_EMAIL=ban@vidu.com
